<?xml version="1.0" encoding="UTF-8" ?>
<DrokkStorage>
	<!-- MULTIPLAYER: every gameplay setting below is taken from the SERVER's copy of this file.
	     The server sends its values to each player as they spawn in, overwriting whatever their
	     own copy says, so admins configure the mod here on the server and clients cannot opt out.
	     The only settings that stay local to each machine are LockModeIconVisible,
	     LiveRecipeTracking and Debug. -->

	<!-- Range in blocks to search nearby containers when crafting, repairing/upgrading,
	     reloading and refueling. Default 15. -->
	<ContainerRange value="15" />

	<!-- Radius in blocks (applied to each axis) searched when Quick Stacking / Restocking
	     into nearby containers. Default 15. -->
	<QuickStackDistance value="15" />

	<!-- Master switch for pulling from nearby containers when crafting, repairing/upgrading,
	     reloading and refueling. Set false to disable all of the below at once. Default true. -->
	<CraftFromContainersEnabled value="true" />

	<!-- Allow repairing/upgrading blocks using materials from nearby containers. Default true. -->
	<EnableForRepairAndUpgrade value="true" />

	<!-- Allow reloading weapons using ammo from nearby containers. Default true. -->
	<EnableForReload value="true" />

	<!-- Allow refueling (generators, vehicles, etc.) using fuel from nearby containers. Default true. -->
	<EnableForRefuel value="true" />

	<!-- Allow pulling from containers that are locked but you already have access to (owner or
	     correct keypad code) as part of your normal pull range. This does NOT let you pull from
	     containers locked by other players that you have no access to — that check always applies
	     regardless of this setting. Set false to exclude even your own locked containers, requiring
	     them to be unlocked to be auto-pulled from. Default true. -->
	<AllowLockedContainers value="true" />

	<!-- Restrict Quick Stack, Quick Restock, and the craft / repair / upgrade / reload / refuel
	     pull to containers YOU placed. Intended for shared bases where players don't pool loot.
	     Default false (any nearby player-placed container is used, as before).

	     Note: containers with no recorded owner - POI loot crates, prefab-spawned and
	     debug/creative-placed containers - are ALWAYS excluded, whatever this is set to. The mod
	     never quick stacks into, quick restocks from, or crafts/repairs out of world loot.

	     When true, on top of that:
	       * Owner only. The player who placed the container is the only one it works for -
	         knowing its keypad code, or being in the same party, does NOT count.
	       * Forges, campfires, dew collectors and apiaries have no owner recorded by the game
	         at all, so land claim stands in for ownership: they only count as a source if they
	         sit inside YOUR land claim (ally claims don't count). One outside any claim is not
	         usable as a source. Outside survival mode the game treats every position as yours,
	         so this part has no effect there.
	       * Vehicles and drones were already restricted to their owner - unchanged.
	       * This does NOT stop players opening each other's unlocked containers by hand; that
	         is vanilla behaviour. Lock a container to prevent that.

	     -->
	<CheckOwnership value="false" />

	<!-- Allow multiple players to view/modify the same container at once (SHARED locks).
	     Set false to restore vanilla single-viewer behavior. Default true. -->
	<MultiViewersEnabled value="true" />

	<!-- Count owned, unlocked vehicle storage as a pullable source. Default true. -->
	<PullFromVehicles value="true" />

	<!-- Count owned drone storage as a pullable source. Default true. -->
	<PullFromDrones value="true" />

	<!-- Count workstation OUTPUT slots (forge, campfire, etc.) as a pullable source. Default true.
	     A workstation you currently have OPEN is never counted, whatever this is set to - while its
	     window is up the UI owns the output slots and anything taken from them behind its back is
	     undone when you close it. -->
	<PullFromWorkstationOutputs value="true" />

	<!-- Count dew collectors / apiaries as a pullable source. Default true. -->
	<PullFromDewCollectors value="true" />

	<!-- Refresh pinned recipe trackers / open crafting windows when a nearby workstation
	     finishes crafting/cooking. Default true. -->
	<LiveRecipeTracking value="true" />

	<!-- Show the lock-mode toggle icon in the player controls UI. Default true. -->
	<LockModeIconVisible value="true" />

	<!-- Verbose per-packet/per-sync logging (container sends/receives, viewer tracking, window
	     open/close, etc). Only needed when diagnosing a sync bug - leave false otherwise, since
	     this logging runs on every container sync near the player and spams the console /
	     costs frame time. Default false. -->
	<Debug value="false" />
</DrokkStorage>
